---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const description = `Sección de la ${site.name} dedicada a presentar sus creencias y enseñanza.`;
---

<!-- Temporalmente noindex hasta publicar el contenido doctrinal oficial -->
<BaseLayout title="Lo que creemos" description={description} noindex>
	<main id="main-content">
		<header class="page-header">
			<div class="container">
				<h1>Lo que creemos</h1>
				<p>Esta sección estará dedicada a presentar de forma clara lo que creemos como iglesia.</p>
			</div>
		</header>

		<section class="section" aria-labelledby="en-preparacion">
			<div class="container split">
				<h2 id="en-preparacion">Contenido en preparación</h2>
				<div class="prose">
					<p>
						Estamos preparando el contenido de esta sección para publicarlo de forma clara y fiel a
						la enseñanza de la iglesia.
					</p>
					<p>
						Cuando esté disponible, aquí podrás consultar nuestras creencias de manera organizada.
					</p>
				</div>
			</div>
		</section>

		<section class="section section--bordered" aria-labelledby="mientras-tanto">
			<div class="container">
				<h2 id="mientras-tanto">Mientras tanto</h2>
				<ul class="card-list">
					<li class="card">
						<h3>Sermones</h3>
						<p>Puedes consultar la sección de sermones y nuestro canal oficial en YouTube.</p>
						<a class="button button--secondary" href={site.routes.sermons}>
							Ver sermones
						</a>
					</li>
					<li class="card">
						<h3>Nosotros</h3>
						<p>Consulta la información general disponible sobre la iglesia.</p>
						<a class="button button--secondary" href={site.routes.nosotros}>
							Conocer la iglesia
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.page-header {
		padding-block: var(--space-12);
		background-color: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	h1 {
		font-size: var(--font-size-3xl);
		letter-spacing: -0.02em;
	}

	.page-header p {
		max-width: var(--content-max);
		margin-top: var(--space-4);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.section {
		padding-block: var(--space-12);
	}

	.section--bordered {
		border-top: 1px solid var(--color-border);
	}

	h2 {
		font-size: var(--font-size-2xl);
		letter-spacing: -0.01em;
	}

	.split {
		display: grid;
		gap: var(--space-6);
	}

	.prose {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: var(--content-max);
	}

	.card-list {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-8);
		list-style: none;
		padding: 0;
	}

	.card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-top: 4px solid var(--color-text);
		border-radius: var(--radius-md);
	}

	h3 {
		font-size: var(--font-size-xl);
	}

	.card p {
		color: var(--color-text-muted);
	}

	.card .button {
		margin-top: auto;
	}

	@media (min-width: 48rem) {
		.page-header,
		.section {
			padding-block: var(--space-16);
		}

		.card-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.split {
			grid-template-columns: 1fr 2fr;
			gap: var(--space-12);
		}
	}
</style>
