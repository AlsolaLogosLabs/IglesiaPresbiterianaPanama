---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const description = `Conoce la identidad bíblica y reformada de la ${site.name} y su suscripción a la Confesión de Fe y los Catecismos de Westminster.`;
---

<BaseLayout title="Lo que creemos" description={description}>
	<main id="main-content">
		<header class="page-header">
			<div class="container">
				<h1>Lo que creemos</h1>
				<p>{`La ${site.name} es una iglesia cristiana, bíblica y reformada.`}</p>
				<p>En esta sección presentamos de forma breve nuestra identidad confesional.</p>
			</div>
		</header>

		<section class="section" aria-labelledby="identidad">
			<div class="container split">
				<h2 id="identidad">Una fe cristiana, bíblica y reformada</h2>
				<div class="prose">
					<p>{`La ${site.name} se identifica como una iglesia cristiana, bíblica y reformada.`}</p>
					<p>Esta identidad orienta la enseñanza de la iglesia.</p>
				</div>
			</div>
		</section>

		<section class="section section--bordered" aria-labelledby="confesion">
			<div class="container split">
				<h2 id="confesion">Nuestra confesión</h2>
				<div class="prose">
					<p class="prose__lead">
						{`La ${site.name} se suscribe a la Confesión de Fe de Westminster y a los Catecismos Mayor y Menor de Westminster.`}
					</p>
					<p>
						Estos documentos expresan de manera organizada la identidad confesional que profesamos
						como iglesia.
					</p>
				</div>
			</div>
		</section>

		<section class="section section--surface" aria-labelledby="ensenanza">
			<div class="container split">
				<h2 id="ensenanza">Enseñanza y sermones</h2>
				<div class="prose">
					<p>
						Puedes consultar nuestros sermones para conocer la enseñanza compartida en la iglesia.
					</p>
					<a class="button" href={site.routes.sermons}>
						Ver sermones
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.page-header {
		padding-block: var(--space-12);
		background-color: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	h1 {
		font-size: var(--font-size-3xl);
		letter-spacing: -0.03em;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	.page-header p {
		max-width: var(--content-max);
		margin-top: var(--space-6);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.page-header p + p {
		margin-top: var(--space-3);
	}

	.section {
		padding-block: var(--space-12);
	}

	.section--bordered {
		border-top: 1px solid var(--color-border);
	}

	.section--surface {
		background-color: var(--color-surface);
		border-top: 1px solid var(--color-border);
	}

	h2 {
		font-size: clamp(var(--font-size-2xl), 1.5rem + 1.5vw, 2.5rem);
		letter-spacing: -0.02em;
	}

	.split {
		display: grid;
		gap: var(--space-6);
	}

	.prose {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		max-width: var(--content-max);
	}

	.prose__lead {
		margin-bottom: var(--space-2);
		font-size: clamp(var(--font-size-xl), 1.25rem + 0.75vw, 1.75rem);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-tight);
		letter-spacing: -0.01em;
	}

	.prose .button {
		margin-top: var(--space-4);
	}

	@media (min-width: 48rem) {
		.page-header {
			padding-block: var(--space-16);
		}

		.page-header p {
			font-size: var(--font-size-xl);
			line-height: 1.5;
		}

		.section {
			padding-block: var(--space-16);
		}

		.prose p:not(.prose__lead) {
			font-size: var(--font-size-lg);
		}
	}

	@media (min-width: 64rem) {
		.page-header {
			padding-block: var(--space-20) var(--space-16);
		}

		.section {
			padding-block: var(--space-20);
		}

		.split {
			grid-template-columns: 1fr 2fr;
			gap: var(--space-12);
		}
	}
</style>
