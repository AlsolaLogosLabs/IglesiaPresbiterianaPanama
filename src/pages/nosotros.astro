---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const { city } = site.location;
const description = `Conoce la historia y el enfoque de la ${site.name}, una iglesia cristiana, bíblica y reformada en ${city}.`;
---

<BaseLayout title="Nosotros" description={description}>
	<main id="main-content">
		<header class="page-header">
			<div class="container">
				<h1>Nosotros</h1>
				<p>{`Conoce nuestra identidad, nuestra historia y el enfoque de la ${site.name}.`}</p>
			</div>
		</header>

		<section class="section" aria-labelledby="quienes-somos">
			<div class="container split">
				<h2 id="quienes-somos">Quiénes somos</h2>
				<div class="prose">
					<p class="prose__lead">
						{`Somos la ${site.name}, una iglesia cristiana, bíblica y reformada en ${city}.`}
					</p>
					<p>
						En esta página compartimos cómo comenzó nuestro trabajo y hacia dónde lo orientamos.
					</p>
				</div>
			</div>
		</section>

		<section class="section section--bordered" aria-labelledby="historia">
			<div class="container split">
				<h2 id="historia">Nuestra historia</h2>
				<div class="prose">
					<p>
						{`El trabajo que dio origen a la ${site.name} comenzó en 2011 por medio de la Agencia Presbiteriana de Misiones Transculturales (APMT) de la Iglesia Presbiteriana de Brasil, con el trabajo misionero pionero de Gilberto Botelho.`}
					</p>
					<p>
						Con el paso de los años, la congregación avanzó en su organización y consolidación como
						iglesia local.
					</p>
					<p>
						Durante 2025 se avanzó en el establecimiento de liderazgo presbiteriano local,
						incluyendo la elección e instalación de tres presbíteros nacionales.
					</p>
				</div>
			</div>
		</section>

		<section class="section section--surface" aria-labelledby="enfoque">
			<div class="container split">
				<h2 id="enfoque">Nuestro enfoque</h2>
				<div class="prose">
					<p>
						Buscamos crecer como iglesia por medio de la enseñanza de la Palabra, el discipulado, el
						cuidado pastoral y la formación de nuevos líderes.
					</p>
					<p>
						También deseamos contribuir a la formación de nuevos obreros y a la plantación de más
						iglesias reformadas en Panamá.
					</p>
				</div>
			</div>
		</section>

		<section class="section section--bordered" aria-labelledby="conoce-mas">
			<div class="container">
				<h2 id="conoce-mas">Conoce más</h2>
				<ul class="card-list">
					<li class="card">
						<h3>Lo que creemos</h3>
						<p>
							Conoce nuestra identidad reformada y los documentos confesionales que suscribimos.
						</p>
						<a class="button button--secondary" href={site.routes.beliefs}>
							Conocer lo que creemos
						</a>
					</li>
					<li class="card">
						<h3>Sermones</h3>
						<p>Consulta los sermones publicados y el acceso a nuestro canal oficial en YouTube.</p>
						<a class="button button--secondary" href={site.routes.sermons}>
							Ver sermones
						</a>
					</li>
					<li class="card">
						<h3>Visítanos</h3>
						<p>Consulta nuestra ubicación y los horarios de las reuniones semanales.</p>
						<a class="button button--secondary" href={site.routes.visit}>
							Información para visitarnos
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.page-header {
		padding-block: var(--space-12);
		background-color: var(--color-brand-surface);
		border-bottom: 1px solid var(--color-border);
	}

	h1 {
		font-size: var(--font-size-3xl);
		letter-spacing: -0.03em;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	.page-header p {
		max-width: var(--content-max);
		margin-top: var(--space-6);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.section {
		padding-block: var(--space-12);
	}

	.section--bordered {
		border-top: 1px solid var(--color-border);
	}

	.section--surface {
		background-color: var(--color-brand-surface);
		border-top: 1px solid var(--color-border);
	}

	h2 {
		font-size: clamp(var(--font-size-2xl), 1.5rem + 1.5vw, 2.5rem);
		letter-spacing: -0.02em;
	}

	.split {
		display: grid;
		gap: var(--space-6);
	}

	.prose {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		max-width: var(--content-max);
	}

	.prose__lead {
		margin-bottom: var(--space-2);
		font-size: clamp(var(--font-size-xl), 1.25rem + 0.75vw, 1.75rem);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-tight);
		letter-spacing: -0.01em;
	}

	.card-list {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-8);
		list-style: none;
		padding: 0;
	}

	.card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background-color: var(--color-bg);
		transition: border-color var(--duration-fast) ease;
	}

	.card:hover,
	.card:focus-within {
		border-color: var(--color-brand);
	}

	h3 {
		font-size: var(--font-size-xl);
		letter-spacing: -0.01em;
	}

	.card p {
		color: var(--color-text-muted);
	}

	.card .button {
		margin-top: auto;
	}

	@media (min-width: 48rem) {
		.page-header {
			padding-block: var(--space-16);
		}

		.page-header p {
			font-size: var(--font-size-xl);
			line-height: 1.5;
		}

		.section {
			padding-block: var(--space-16);
		}

		.prose p:not(.prose__lead) {
			font-size: var(--font-size-lg);
		}

		.card-list {
			gap: var(--space-6);
			margin-top: var(--space-12);
		}

		.card {
			padding: var(--space-8) var(--space-6) var(--space-6);
		}
	}

	@media (min-width: 64rem) {
		.page-header {
			padding-block: var(--space-20) var(--space-16);
		}

		.section {
			padding-block: var(--space-20);
		}

		.split {
			grid-template-columns: 1fr 2fr;
			gap: var(--space-12);
		}

		.card-list {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
