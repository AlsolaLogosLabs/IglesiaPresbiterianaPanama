---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
	title="Página no encontrada"
	description="La página que buscas no está disponible."
	noindex
>
	<main id="main-content" class="container not-found">
		<p class="not-found__code" aria-hidden="true">
			404
		</p>
		<h1>Página no encontrada</h1>
		<p class="not-found__text">
			La página que buscas no existe o pudo haber cambiado de dirección.
		</p>
		<a class="button" href={site.routes.home}>
			Volver al inicio
		</a>
	</main>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding-block: var(--space-16);
	}

	.not-found__code {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	h1 {
		margin-top: var(--space-3);
		font-size: var(--font-size-3xl);
		letter-spacing: -0.03em;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	.not-found__text {
		max-width: var(--content-max);
		margin-top: var(--space-6);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.not-found .button {
		margin-top: var(--space-8);
	}

	@media (min-width: 48rem) {
		.not-found {
			padding-block: var(--space-20);
		}

		.not-found__text {
			font-size: var(--font-size-xl);
			line-height: 1.5;
		}
	}
</style>
