---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import WeeklySchedule from '../components/home/WeeklySchedule.astro';
import { site } from '../config/site';

const { venue, street, city, country } = site.location;
const youtube = site.social.find((link) => link.name === 'YouTube');

const sermons = (await getCollection('sermons')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestSermon = sermons[0];
const dateFormat = new Intl.DateTimeFormat('es-PA', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

const homeURL = new URL(site.routes.home, Astro.site).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${homeURL}#organization`,
			name: site.name,
			url: homeURL,
			description: site.description,
			sameAs: site.social.map((link) => link.url),
		},
		{
			'@type': 'WebSite',
			'@id': `${homeURL}#website`,
			url: homeURL,
			name: site.name,
			description: site.description,
			inLanguage: 'es-PA',
			publisher: { '@id': `${homeURL}#organization` },
		},
	],
};
---

<BaseLayout>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main id="main-content">
		<Hero />

		<section class="section" aria-labelledby="horarios">
			<div class="container">
				<div class="section__header">
					<h2 id="horarios">Horarios</h2>
					<p>Nuestras reuniones semanales.</p>
				</div>
				<WeeklySchedule />
			</div>
		</section>

		<div class="container intro-pair">
			<section class="intro" aria-labelledby="bienvenida">
				<h2 id="bienvenida">Bienvenida</h2>
				<p>
					Si nos visitas por primera vez, eres bienvenido a acompañarnos en cualquiera de nuestras
					reuniones semanales.
				</p>
				<a class="button button--secondary" href={site.routes.nosotros}>
					Conócenos
				</a>
			</section>

			<section class="intro" aria-labelledby="creencias">
				<h2 id="creencias">Lo que creemos</h2>
				<p>
					Somos una iglesia bíblica y reformada que se suscribe a la Confesión de Fe y los
					Catecismos de Westminster.
				</p>
				<a class="button button--secondary" href={site.routes.beliefs}>
					Conoce lo que creemos
				</a>
			</section>
		</div>

		<section class="section section--inverse" aria-labelledby="sermones">
			{latestSermon ? (
				<div class="container">
					<h2 id="sermones">Sermones</h2>
					<div class="latest">
						<img
							class="latest__thumb"
							src={`https://i.ytimg.com/vi/${latestSermon.data.youtubeId}/hqdefault.jpg`}
							alt={`Miniatura del sermón «${latestSermon.data.title}»`}
							width="480"
							height="360"
							loading="lazy"
							decoding="async"
						/>
						<div class="latest__content">
							<p class="latest__label">Último sermón</p>
							<h3 class="latest__title">
								<a href={`${site.routes.sermons}${latestSermon.id}/`}>{latestSermon.data.title}</a>
							</h3>
							<p class="latest__meta">
								<time datetime={latestSermon.data.date.toISOString().slice(0, 10)}>
									{dateFormat.format(latestSermon.data.date)}
								</time>
								{latestSermon.data.preacher && <span>{latestSermon.data.preacher}</span>}
							</p>
							{latestSermon.data.scripture && (
								<p class="latest__scripture">{latestSermon.data.scripture}</p>
							)}
							<div class="actions">
								<a class="button" href={`${site.routes.sermons}${latestSermon.id}/`}>
									Ver sermón
								</a>
								<a class="button button--secondary" href={site.routes.sermons}>
									Todos los sermones
								</a>
								{youtube && (
									<a class="button button--secondary" href={youtube.url} rel="noopener">
										Canal oficial en YouTube
									</a>
								)}
							</div>
						</div>
					</div>
				</div>
			) : (
				<div class="container split">
					<div>
						<h2 id="sermones">Sermones</h2>
						<p>Consulta nuestra sección de sermones y nuestro canal oficial en YouTube.</p>
					</div>
					<div class="actions">
						<a class="button" href={site.routes.sermons}>
							Ver sermones
						</a>
						{youtube && (
							<a class="button button--secondary" href={youtube.url} rel="noopener">
								Ver canal oficial en YouTube
							</a>
						)}
					</div>
				</div>
			)}
		</section>

		<section class="section section--surface" aria-labelledby="primera-visita">
			<div class="container visit">
				<div class="visit__info">
					<h2 id="primera-visita">Primera visita</h2>
					<h3>Dónde nos reunimos</h3>
					<address>
						{venue}
						<br />
						{street}
						<br />
						{city}, {country}
					</address>
					<a class="button" href={site.routes.visit}>
						Cómo visitarnos
					</a>
				</div>
				<div>
					<h3>Cuándo nos reunimos</h3>
					<WeeklySchedule variant="compact" />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-16);
	}

	.section--surface {
		background-color: var(--color-brand-surface);
		border-top: 1px solid var(--color-border);
	}

	.section--inverse {
		--focus-color: var(--color-inverse-text);
		background-color: var(--color-inverse-bg);
		color: var(--color-inverse-text);
	}

	h2 {
		font-size: clamp(var(--font-size-2xl), 1.5rem + 1.5vw, 2.5rem);
		letter-spacing: -0.02em;
	}

	h3 {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	p {
		max-width: var(--content-max);
	}

	.section__header {
		margin-bottom: var(--space-8);
	}

	.section__header p {
		margin-top: var(--space-3);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	/* Bienvenida + Lo que creemos */
	.intro-pair {
		display: grid;
		padding-bottom: var(--space-16);
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		padding-block: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	.intro p {
		font-size: var(--font-size-lg);
	}

	.intro .button {
		margin-top: auto;
	}

	/* Sermones */
	.section--inverse p {
		margin-top: var(--space-4);
		color: var(--color-inverse-muted);
	}

	.section--inverse .button {
		background-color: var(--color-inverse-text);
		border-color: var(--color-inverse-text);
		color: var(--color-inverse-bg);
	}

	.section--inverse .button:hover {
		background-color: var(--color-inverse-muted);
		border-color: var(--color-inverse-muted);
	}

	.section--inverse .button--secondary {
		background-color: transparent;
		color: var(--color-inverse-text);
	}

	.section--inverse .button--secondary:hover {
		background-color: transparent;
		border-color: var(--color-inverse-text);
	}

	.section--inverse .button:active {
		background-color: var(--color-inverse-text);
		border-color: var(--color-inverse-text);
	}

	.section--inverse .button--secondary:active {
		background-color: rgb(255 255 255 / 0.12);
	}

	.split {
		display: grid;
		gap: var(--space-8);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.actions .button {
		flex: 1 1 12rem;
	}

	.latest {
		display: grid;
		gap: var(--space-6);
		margin-top: var(--space-8);
	}

	.latest__thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-md);
		background-color: var(--color-text-muted);
	}

	.latest__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		min-width: 0;
	}

	.section--inverse .latest__content p {
		margin-top: 0;
	}

	.latest__label {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.latest__title {
		font-size: clamp(var(--font-size-xl), 1.1rem + 1.5vw, 2.25rem);
		text-transform: none;
		letter-spacing: -0.02em;
		line-height: var(--line-height-tight);
		color: var(--color-inverse-text);
		overflow-wrap: break-word;
	}

	.latest__title a {
		text-decoration-color: var(--color-inverse-muted);
	}

	.latest__title a:hover {
		text-decoration-color: currentColor;
	}

	.latest__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
	}

	.section--inverse .latest__scripture {
		font-weight: var(--font-weight-semibold);
		color: var(--color-inverse-text);
	}

	.latest .actions {
		margin-top: var(--space-4);
	}

	/* Primera visita: el título ocupa todo el ancho y «Dónde» / «Cuándo» quedan alineados */
	.visit {
		display: grid;
	}

	.visit__info {
		display: contents;
	}

	.visit__info h2 {
		margin-bottom: var(--space-8);
	}

	.visit h3 {
		margin-bottom: var(--space-3);
	}

	address {
		font-style: normal;
		font-size: var(--font-size-lg);
	}

	.visit__info .button {
		justify-self: start;
		margin-top: var(--space-6);
	}

	.visit > div:last-child {
		margin-top: var(--space-12);
	}

	@media (min-width: 48rem) {
		.section {
			padding-block: var(--space-20);
		}

		.intro-pair {
			grid-template-columns: 1fr 1fr;
			padding-block: 0 var(--space-20);
		}

		.intro {
			padding: var(--space-12) var(--space-12) 0 0;
		}

		/* Divisor vertical entre ambos bloques */
		.intro + .intro {
			padding-inline: var(--space-12) 0;
			border-left: 1px solid var(--color-border);
		}

		.actions .button {
			flex: 0 0 auto;
		}

		.visit {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto auto auto 1fr;
			column-gap: var(--space-16);
		}

		.visit__info .button {
			align-self: start;
		}

		.visit__info h2 {
			grid-column: 1 / -1;
			margin-bottom: var(--space-12);
		}

		.visit > div:last-child {
			grid-column: 2;
			grid-row: 2 / span 3;
			margin-top: 0;
		}

		address {
			font-size: var(--font-size-xl);
			line-height: 1.4;
		}
	}

	@media (min-width: 64rem) {
		.split {
			grid-template-columns: 1fr auto;
			align-items: end;
		}

		.latest {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: center;
			gap: var(--space-12);
			margin-top: var(--space-12);
		}
	}
</style>
