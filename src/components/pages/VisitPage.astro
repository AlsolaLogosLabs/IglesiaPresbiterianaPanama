---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../layout/PageHeader.astro';
import WeeklySchedule from '../home/WeeklySchedule.astro';
import { site } from '../../config/site';
import { toLocale } from '../../i18n/locales';
import { messages } from '../../i18n/messages';
import interiorPhoto from '../../assets/photos/interior-reunion.jpg';

const t = messages[toLocale(Astro.currentLocale)].visit;
const { venue, street, city, country, mapsUrl } = site.location;
---

<BaseLayout title={t.title} description={t.metaDescription}>
	<main id="main-content">
		<PageHeader title={t.title} description={t.description} />

		<section class="section" aria-labelledby="ubicacion">
			<div class="container split">
				<h2 id="ubicacion">{t.whereTitle}</h2>
				<div class="location">
					<div class="location__details">
						<address>
							<span class="address__venue">{venue}</span>
							<span>{street}</span>
							<span>{`${city}, ${country}`}</span>
						</address>
						<a class="button button--secondary" href={mapsUrl}>
							{t.mapsCta}
						</a>
					</div>
					<div class="location__photo">
						<Picture
							src={interiorPhoto}
							formats={['avif', 'webp']}
							widths={[480, 720, 960, interiorPhoto.width]}
							sizes="(min-width: 72rem) 694px, (min-width: 64rem) calc((100vw - 7rem) * 2 / 3), (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2rem)"
							alt={t.photoAlt}
							loading="lazy"
						/>
					</div>
				</div>
			</div>
		</section>

		<section class="section section--bordered" aria-labelledby="horarios">
			<div class="container">
				<div class="section__header">
					<h2 id="horarios">{t.scheduleTitle}</h2>
					<p>{t.scheduleIntro}</p>
				</div>
				<WeeklySchedule />
				{/* Un único calendario técnico (en español) para todos los idiomas */}
				<a
					class="button button--secondary calendar-link"
					href={`${site.routes.home}horarios.ics`}
					download="horarios-iglesia.ics"
				>
					{t.calendarCta}
				</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-12);
	}

	.section--bordered {
		border-top: 1px solid var(--color-border);
	}

	h2 {
		font-size: clamp(var(--font-size-2xl), 1.6rem + 1vw, 2.25rem);
		letter-spacing: -0.01em;
	}

	.split {
		display: grid;
		gap: var(--space-6);
	}

	address {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		font-style: normal;
		font-size: var(--font-size-lg);
	}

	.address__venue {
		margin-bottom: var(--space-2);
		font-size: clamp(var(--font-size-xl), 1.25rem + 1vw, var(--font-size-2xl));
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-tight);
		letter-spacing: -0.02em;
		overflow-wrap: break-word;
	}

	.location {
		display: grid;
		gap: var(--space-8);
	}

	/* Dirección y enlace a Maps agrupados; el botón conserva su ancho natural */
	.location__details {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	/* Frame del culto: recortado 16:9 en origen; radius como el último sermón en Home */
	.location__photo :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		background-color: var(--color-surface);
	}

	.section__header {
		margin-bottom: var(--space-8);
	}

	.section__header p {
		margin-top: var(--space-3);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.calendar-link {
		margin-top: var(--space-8);
	}

	@media (min-width: 48rem) {
		.section {
			padding-block: var(--space-16);
		}
	}

	@media (min-width: 64rem) {
		.split {
			grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
			gap: var(--space-12);
		}
	}
</style>
