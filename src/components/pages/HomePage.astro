---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../home/Hero.astro';
import { site } from '../../config/site';
import { localeMeta, toLocale } from '../../i18n/locales';
import { messages } from '../../i18n/messages';
import { localizedRoutes } from '../../i18n/routes';

const locale = toLocale(Astro.currentLocale);
const t = messages[locale].home;
const routes = localizedRoutes(locale);
const youtube = site.social.find((link) => link.name === 'YouTube');

const sermons = (await getCollection('sermons')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestSermon = sermons[0];
const dateFormat = new Intl.DateTimeFormat(localeMeta[locale].intl, {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

// Una sola identidad (URL en español); solo cambian descripción e idioma.
const homeURL = new URL(site.routes.home, Astro.site).href;
const description = messages[locale].meta.description;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${homeURL}#organization`,
			name: site.name,
			url: homeURL,
			description,
			sameAs: site.social.map((link) => link.url),
		},
		{
			'@type': 'WebSite',
			'@id': `${homeURL}#website`,
			url: homeURL,
			name: site.name,
			description,
			inLanguage: localeMeta[locale].intl,
			publisher: { '@id': `${homeURL}#organization` },
		},
	],
};
---

<BaseLayout>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main id="main-content">
		<Hero />

		<div class="container intro-pair">
			<section class="intro" aria-labelledby="historia">
				<h2 id="historia">{t.historyTitle}</h2>
				<p>{t.historyText}</p>
				<a class="button button--secondary" href={routes.nosotros}>
					{t.historyCta}
				</a>
			</section>

			<section class="intro" aria-labelledby="creencias">
				<h2 id="creencias">{t.beliefsTitle}</h2>
				<p>{t.beliefsText}</p>
				<a class="button button--secondary" href={routes.beliefs}>
					{t.beliefsCta}
				</a>
			</section>
		</div>

		<section class="section section--inverse" aria-labelledby="sermones">
			{latestSermon ? (
				<div class="container">
					<h2 id="sermones">{t.sermonsTitle}</h2>
					<div class="latest">
						<img
							class="latest__thumb"
							src={`https://i.ytimg.com/vi/${latestSermon.data.youtubeId}/hqdefault.jpg`}
							alt={messages[locale].sermons.thumbnailAlt(latestSermon.data.title)}
							width="480"
							height="360"
							loading="lazy"
							decoding="async"
						/>
						<div class="latest__content">
							<p class="latest__label">{t.latestSermon}</p>
							<h3 class="latest__title">
								<a href={`${routes.sermons}${latestSermon.id}/`}>{latestSermon.data.title}</a>
							</h3>
							<p class="latest__meta">
								<time datetime={latestSermon.data.date.toISOString().slice(0, 10)}>
									{dateFormat.format(latestSermon.data.date)}
								</time>
								{latestSermon.data.preacher && <span>{latestSermon.data.preacher}</span>}
							</p>
							{latestSermon.data.scripture && (
								<p class="latest__scripture">{latestSermon.data.scripture}</p>
							)}
							<div class="actions">
								<a class="button" href={`${routes.sermons}${latestSermon.id}/`}>
									{t.watchSermon}
								</a>
								<a class="button button--secondary" href={routes.sermons}>
									{t.allSermons}
								</a>
								{youtube && (
									<a class="button button--secondary" href={youtube.url} rel="noopener">
										{t.youtubeChannel}
									</a>
								)}
							</div>
						</div>
					</div>
				</div>
			) : (
				<div class="container split">
					<div>
						<h2 id="sermones">{t.sermonsTitle}</h2>
						<p>{t.sermonsFallback}</p>
					</div>
					<div class="actions">
						<a class="button" href={routes.sermons}>
							{t.viewSermons}
						</a>
						{youtube && (
							<a class="button button--secondary" href={youtube.url} rel="noopener">
								{t.viewYoutube}
							</a>
						)}
					</div>
				</div>
			)}
		</section>
	</main>
</BaseLayout>

<style>
	.section {
		padding-block: var(--space-16);
	}

	.section--inverse {
		--focus-color: var(--color-inverse-text);
		background-color: var(--color-inverse-bg);
		color: var(--color-inverse-text);
	}

	h2 {
		font-size: clamp(var(--font-size-2xl), 1.5rem + 1.5vw, 2.5rem);
		letter-spacing: -0.02em;
	}

	h3 {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	p {
		max-width: var(--content-max);
	}

	/* Nuestra historia + Lo que creemos */
	.intro-pair {
		display: grid;
		padding-bottom: var(--space-16);
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		padding-block: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	.intro p {
		font-size: var(--font-size-lg);
	}

	.intro .button {
		margin-top: auto;
	}

	/* Sermones */
	.section--inverse p {
		margin-top: var(--space-4);
		color: var(--color-inverse-muted);
	}

	.section--inverse .button {
		background-color: var(--color-inverse-text);
		border-color: var(--color-inverse-text);
		color: var(--color-inverse-bg);
	}

	.section--inverse .button:hover {
		background-color: var(--color-inverse-muted);
		border-color: var(--color-inverse-muted);
	}

	.section--inverse .button--secondary {
		background-color: transparent;
		color: var(--color-inverse-text);
	}

	.section--inverse .button--secondary:hover {
		background-color: transparent;
		border-color: var(--color-inverse-text);
	}

	.section--inverse .button:active {
		background-color: var(--color-inverse-text);
		border-color: var(--color-inverse-text);
	}

	.section--inverse .button--secondary:active {
		background-color: rgb(255 255 255 / 0.12);
	}

	.split {
		display: grid;
		gap: var(--space-8);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.actions .button {
		flex: 1 1 12rem;
	}

	.latest {
		display: grid;
		gap: var(--space-6);
		margin-top: var(--space-8);
	}

	.latest__thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-md);
		background-color: var(--color-text-muted);
	}

	.latest__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		min-width: 0;
	}

	.section--inverse .latest__content p {
		margin-top: 0;
	}

	.latest__label {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.latest__title {
		font-size: clamp(var(--font-size-xl), 1.1rem + 1.5vw, 2.25rem);
		text-transform: none;
		letter-spacing: -0.02em;
		line-height: var(--line-height-tight);
		color: var(--color-inverse-text);
		overflow-wrap: break-word;
	}

	.latest__title a {
		text-decoration-color: var(--color-inverse-muted);
	}

	.latest__title a:hover {
		text-decoration-color: currentColor;
	}

	.latest__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
	}

	.section--inverse .latest__scripture {
		font-weight: var(--font-weight-semibold);
		color: var(--color-inverse-text);
	}

	.latest .actions {
		margin-top: var(--space-6);
	}

	@media (min-width: 48rem) {
		.section {
			padding-block: var(--space-20);
		}

		.intro-pair {
			grid-template-columns: 1fr 1fr;
			padding-block: 0 var(--space-20);
		}

		.intro {
			padding: var(--space-12) var(--space-12) 0 0;
		}

		/* Divisor vertical entre ambos bloques */
		.intro + .intro {
			padding-inline: var(--space-12) 0;
			border-left: 1px solid var(--color-border);
		}

		.actions .button {
			flex: 0 0 auto;
		}
	}

	@media (min-width: 64rem) {
		.split {
			grid-template-columns: 1fr auto;
			align-items: end;
		}

		.latest {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			align-items: center;
			gap: var(--space-12);
			margin-top: var(--space-12);
		}

		.latest__thumb {
			border-radius: var(--radius-lg);
		}

		.latest__title {
			font-size: clamp(var(--font-size-2xl), 1rem + 1.75vw, 2.5rem);
		}
	}
</style>
