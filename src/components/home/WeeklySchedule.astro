---
import { site } from '../../config/site';

interface Props {
	variant?: 'cards' | 'compact';
}

const { variant = 'cards' } = Astro.props;
---

<ul class:list={['schedule', `schedule--${variant}`]}>
	{site.schedule.map((item) => (
		<li class="schedule__item">
			<span class="schedule__day">{item.day}</span>
			<span class="schedule__name">{item.name}</span>
			<span class="schedule__time">{item.time}</span>
		</li>
	))}
</ul>

<style>
	.schedule {
		list-style: none;
		padding: 0;
	}

	.schedule__day {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}

	.schedule__name {
		font-weight: var(--font-weight-semibold);
	}

	/* Cards */
	.schedule--cards {
		display: grid;
		gap: var(--space-4);
	}

	.schedule--cards .schedule__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-top: 4px solid var(--color-text);
		border-radius: var(--radius-md);
		background-color: var(--color-bg);
	}

	.schedule--cards .schedule__name {
		font-size: var(--font-size-lg);
		line-height: var(--line-height-tight);
	}

	.schedule--cards .schedule__time {
		margin-top: auto;
		padding-top: var(--space-2);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-tight);
	}

	@media (min-width: 48rem) {
		.schedule--cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Compact */
	.schedule--compact .schedule__item {
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: var(--space-4);
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	.schedule--compact .schedule__item:first-child {
		border-top: 1px solid var(--color-border);
	}

	.schedule--compact .schedule__name {
		grid-column: 1;
	}

	.schedule--compact .schedule__time {
		grid-column: 2;
		grid-row: 1 / span 2;
		align-self: center;
		font-weight: var(--font-weight-bold);
		white-space: nowrap;
	}
</style>
