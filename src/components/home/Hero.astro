---
import { site } from '../../config/site';

const { venue, street, city } = site.location;
const lead = `Te invitamos a acompañarnos en nuestras reuniones semanales en ${venue}, ${street}, ${city}.`;
---

<section class="hero">
	<div class="container">
		<h1>{site.name}</h1>
		<p class="hero__lead">{lead}</p>
		<div class="hero__actions">
			<a class="button" href="/visitanos/">
				Visítanos
			</a>
			<a class="button button--secondary" href="/sermones/">
				Ver sermones
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-16);
		background-color: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	h1 {
		max-width: 16ch;
		font-size: var(--font-size-3xl);
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.hero__lead {
		max-width: var(--content-max);
		margin-top: var(--space-6);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.hero__actions .button {
		flex: 1 1 10rem;
	}

	@media (min-width: 48rem) {
		.hero {
			padding-block: var(--space-20);
		}

		.hero__lead {
			font-size: var(--font-size-xl);
			line-height: 1.5;
		}

		.hero__actions .button {
			flex: 0 0 auto;
		}
	}
</style>
