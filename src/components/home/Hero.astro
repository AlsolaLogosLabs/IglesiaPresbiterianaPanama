---
import { site } from '../../config/site';
import { toLocale } from '../../i18n/locales';
import { localizedSchedule, messages } from '../../i18n/messages';
import { localizedRoutes } from '../../i18n/routes';

const locale = toLocale(Astro.currentLocale);
const t = messages[locale].home;
const routes = localizedRoutes(locale);
const { venue, street, city } = site.location;

// Resumen de reuniones agrupado por día, derivado de site.schedule
const schedule = localizedSchedule(locale);
const days = [...new Set(schedule.map((item) => item.day))].map((day) => ({
	day,
	items: schedule.filter((item) => item.day === day),
}));
---

<section class="hero">
	<div class="container hero__inner">
		<div class="hero__main">
			<h1>{site.name}</h1>
			<p class="hero__lead">{t.lead}</p>
			<div class="hero__actions">
				<a class="button" href={routes.visit}>
					{t.visitCta}
				</a>
				<a class="button button--secondary" href={routes.sermons}>
					{t.sermonsCta}
				</a>
			</div>
		</div>

		<div class="hero__visit">
			<p class="hero__visit-label">{t.visitPanel}</p>
			<address>
				<strong>{venue}</strong>
				<br />
				{street}
				<br />
				{city}
			</address>
			<dl class="hero__schedule">
				{days.map(({ day, items }) => (
					<div class="hero__day">
						<dt>{day}</dt>
						{items.map((item) => (
							<dd>
								<span>{item.name}</span>
								<span class="hero__time">{item.time}</span>
							</dd>
						))}
					</div>
				))}
			</dl>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-12);
		background-color: var(--color-brand-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.hero__inner {
		display: grid;
		gap: var(--space-12);
	}

	h1 {
		max-width: 14ch;
		font-size: clamp(2.25rem, 1.25rem + 4.5vw, 4.25rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	.hero__lead {
		max-width: 36rem;
		margin-top: var(--space-6);
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.hero__actions .button {
		flex: 1 1 10rem;
	}

	/* El fondo del hero ya es brand-surface: el hover secundario vuelve a blanco */
	.hero .button--secondary:hover {
		background-color: var(--color-bg);
	}

	/* Panel de visita: resumen rápido; el detalle completo está en «Horarios» */
	.hero__visit {
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-top: 4px solid var(--color-brand);
		border-radius: var(--radius-md);
		background-color: var(--color-bg);
	}

	.hero__visit-label,
	.hero__day dt {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.hero__visit-label {
		color: var(--color-brand);
	}

	address {
		margin-top: var(--space-3);
		font-style: normal;
		color: var(--color-text-muted);
	}

	address strong {
		font-size: var(--font-size-xl);
		line-height: var(--line-height-tight);
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.hero__schedule {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-6);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.hero__day dt {
		margin-bottom: var(--space-1);
		color: var(--color-text-muted);
	}

	.hero__day dd {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--space-4);
		font-weight: var(--font-weight-semibold);
	}

	.hero__time {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	@media (min-width: 48rem) {
		.hero {
			padding-block: var(--space-20);
		}

		.hero__lead {
			margin-top: var(--space-8);
			font-size: var(--font-size-xl);
			line-height: 1.5;
		}

		.hero__actions {
			margin-top: var(--space-12);
		}

		.hero__actions .button {
			flex: 0 0 auto;
		}

		/* Tablet: dirección y reuniones lado a lado para no dejar un panel angosto */
		.hero__visit {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			grid-template-rows: auto 1fr;
			column-gap: var(--space-8);
			padding: var(--space-8);
		}

		.hero__schedule {
			grid-column: 2;
			grid-row: 1 / span 2;
			margin-top: 0;
			padding: 0 0 0 var(--space-8);
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}
	}

	@media (min-width: 64rem) {
		.hero {
			padding-block: calc(var(--space-20) + var(--space-4));
		}

		.hero__inner {
			grid-template-columns: minmax(0, 3fr) minmax(18rem, 2fr);
			align-items: center;
			gap: var(--space-16);
		}

		.hero__visit {
			display: block;
		}

		.hero__schedule {
			margin-top: var(--space-6);
			padding: var(--space-6) 0 0;
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}
	}
</style>
