---
import { site } from '../../config/site';

const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = withSlash(Astro.url.pathname);
// Inicio solo coincide exacto; las demás secciones incluyen sus subpáginas.
const isCurrent = (href: string) =>
	href === site.routes.home
		? withSlash(href) === currentPath
		: currentPath.startsWith(withSlash(href));
---

<a class="skip-link" href="#main-content">
	Saltar al contenido
</a>

<header class="site-header">
	<div class="container site-header__inner">
		<a class="site-header__brand" href={site.routes.home}>
			{site.name}
		</a>

		<!-- Mobile/tablet: menú desplegable sin JavaScript -->
		<details class="site-nav site-nav--mobile">
			<summary>Menú</summary>
			<nav aria-label="Principal">
				<ul class="site-nav__list">
					{site.nav.map((item) => (
						<li>
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</details>

		<!-- Desktop: navegación horizontal -->
		<nav class="site-nav site-nav--desktop" aria-label="Principal">
			<ul class="site-nav__list">
				{site.nav.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	.skip-link {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: 100;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		background-color: var(--color-inverse-bg);
		color: var(--color-inverse-text);
		font-weight: var(--font-weight-semibold);
		transform: translateY(calc(-100% - var(--space-4)));
	}

	.skip-link:focus {
		transform: none;
		outline: 3px solid var(--color-text);
		outline-offset: 2px;
	}

	.site-header {
		position: relative;
		z-index: 10;
		border-bottom: 1px solid var(--color-border);
		background-color: var(--color-bg);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 4.5rem;
		padding-block: var(--space-3);
	}

	.site-header__brand {
		min-width: 0;
		max-width: 18ch;
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-tight);
		letter-spacing: -0.02em;
		text-decoration: none;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.site-header__brand:hover {
		text-decoration: underline;
	}

	.site-nav__list {
		list-style: none;
		padding: 0;
	}

	.site-nav a {
		display: flex;
		align-items: center;
		min-height: var(--tap-target);
		color: var(--color-text-muted);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
		transition:
			color var(--duration-fast) ease,
			background-color var(--duration-fast) ease;
	}

	.site-nav a:hover {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.site-nav a[aria-current='page'] {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.4em;
	}

	/* Mobile / tablet */
	.site-nav--mobile {
		flex-shrink: 0;
	}

	.site-nav--mobile summary {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--tap-target);
		padding-inline: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-weight: var(--font-weight-semibold);
		list-style: none;
		cursor: pointer;
		transition:
			background-color var(--duration-fast) ease,
			border-color var(--duration-fast) ease;
	}

	.site-nav--mobile summary:hover {
		border-color: var(--color-text);
	}

	.site-nav--mobile summary:active {
		background-color: var(--color-surface);
	}

	.site-nav--mobile summary::-webkit-details-marker {
		display: none;
	}

	/* Indicador abierto/cerrado */
	.site-nav--mobile summary::after {
		content: '';
		width: 0.5em;
		height: 0.5em;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-25%) rotate(45deg);
	}

	.site-nav--mobile[open] summary {
		background-color: var(--color-surface);
		border-color: var(--color-text);
	}

	.site-nav--mobile[open] summary::after {
		transform: translateY(25%) rotate(-135deg);
	}

	.site-nav--mobile nav {
		position: absolute;
		inset-inline: 0;
		top: 100%;
		padding: var(--space-2) var(--container-padding) var(--space-6);
		background-color: var(--color-bg);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		box-shadow: 0 var(--space-2) var(--space-4) -0.75rem rgb(0 0 0 / 0.2);
	}

	.site-nav--mobile li + li {
		border-top: 1px solid var(--color-border);
	}

	.site-nav--mobile a {
		padding-block: var(--space-3);
		font-size: var(--font-size-lg);
	}

	.site-nav--desktop {
		display: none;
	}

	/* Desktop */
	@media (min-width: 64rem) {
		.site-header__inner {
			min-height: 5rem;
		}

		.site-header__brand {
			max-width: none;
		}

		.site-nav--mobile {
			display: none;
		}

		.site-nav--desktop {
			display: block;
		}

		.site-nav--desktop .site-nav__list {
			display: flex;
			gap: var(--space-1);
		}

		.site-nav--desktop a {
			padding-inline: var(--space-3);
			border-radius: var(--radius-sm);
			white-space: nowrap;
		}

		.site-nav--desktop a:hover {
			background-color: var(--color-surface);
		}
	}
</style>
