---
import { site } from '../../config/site';

const year = new Date().getFullYear();
const { venue, street, city, country } = site.location;
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__main">
			<div>
				<p class="site-footer__name">
					<img src={`${site.routes.home}brand/mark-white.png`} alt="" width="107" height="87" />
					<span>{site.name}</span>
				</p>
				<address>
					{venue}
					<br />
					{street}
					<br />
					{city}, {country}
				</address>
			</div>

			<nav aria-labelledby="footer-social">
				<p class="site-footer__label" id="footer-social">
					Redes sociales
				</p>
				<ul class="site-footer__social">
					{site.social.map((link) => (
						<li>
							<a href={link.url} rel="noopener">
								{link.name}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<div class="site-footer__bottom">
			<p class="site-footer__copy">
				&copy; {year} {site.name}
			</p>
			<nav aria-label="Legal">
				<a class="site-footer__legal" href={site.routes.privacy}>
					Privacidad
				</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		--focus-color: var(--color-inverse-text);
		padding-block: var(--space-16) var(--space-8);
		background-color: var(--color-inverse-bg);
		color: var(--color-inverse-text);
	}

	.site-footer__main {
		display: grid;
		gap: var(--space-8) var(--space-12);
	}

	.site-footer__name {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin-bottom: var(--space-4);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-tight);
		letter-spacing: -0.02em;
	}

	.site-footer__name img {
		flex-shrink: 0;
		width: 2.5rem;
		height: auto;
	}

	.site-footer__name span {
		max-width: 18ch;
	}

	address {
		font-style: normal;
		color: var(--color-inverse-muted);
	}

	.site-footer__label {
		margin-bottom: var(--space-1);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-inverse-muted);
	}

	.site-footer__social {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-6);
		list-style: none;
		padding: 0;
	}

	.site-footer__social a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-target);
		font-weight: var(--font-weight-semibold);
		text-decoration: underline;
		text-decoration-color: var(--color-text-muted);
	}

	.site-footer__social a:hover {
		text-decoration-color: currentColor;
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-6);
		margin-top: var(--space-12);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.site-footer__copy {
		color: var(--color-inverse-muted);
	}

	.site-footer__legal {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-target);
		text-decoration-color: var(--color-text-muted);
	}

	.site-footer__legal:hover {
		text-decoration-color: currentColor;
	}

	@media (min-width: 48rem) {
		.site-footer__main {
			grid-template-columns: 1fr auto;
			align-items: start;
		}
	}
</style>
