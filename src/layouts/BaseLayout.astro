---
import { site } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { localeMeta, locales, toLocale } from '../i18n/locales';
import { messages } from '../i18n/messages';
import { absoluteLocaleUrl, pagePath } from '../i18n/routes';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	image?: string;
	imageAlt?: string;
}

const locale = toLocale(Astro.currentLocale);
const t = messages[locale];
const { title, description = t.meta.description, noindex = false, image, imageAlt } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const baseURL = site.routes.home;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const robots = noindex ? 'noindex, follow' : 'index, follow';
// Las páginas indexables sin imagen propia usan la imagen institucional; la 404 (noindex) no lleva imagen.
const defaultSocialImage = new URL(`${baseURL}brand/og-default.png`, Astro.site).href;
const socialImage = image
	? new URL(image, Astro.site).href
	: !noindex
		? defaultSocialImage
		: undefined;
const socialImageAlt = image ? imageAlt : t.meta.socialImageAlt;

// Mismos slugs en todos los idiomas: la versión alternativa es la misma ruta con otro prefijo.
const path = pagePath(Astro.url.pathname);
const alternates = locales.map((alternate) => ({
	hreflang: localeMeta[alternate].lang,
	href: absoluteLocaleUrl(alternate, path),
}));
---

<html lang={localeMeta[locale].lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		{!noindex && <link rel="canonical" href={canonicalURL} />}
		<link rel="sitemap" href={`${baseURL}sitemap-index.xml`} />
		{!noindex &&
			alternates.map(({ hreflang, href }) => (
				<link rel="alternate" hreflang={hreflang} href={href} />
			))}
		{!noindex && <link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl('es', path)} />}
		{/* El feed de sermones solo existe en español */}
		{!noindex && locale === 'es' && (
			<link
				rel="alternate"
				type="application/rss+xml"
				title={`Sermones — ${site.name}`}
				href={`${site.routes.sermons}rss.xml`}
			/>
		)}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={localeMeta[locale].ogLocale} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalURL} />}
		{socialImage && <meta property="og:image" content={socialImage} />}
		{socialImage && socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}

		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		{socialImage && socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}

		<link rel="icon" type="image/png" href={`${baseURL}favicon.png`} />
	</head>
	<body>
		<Header />
		<!-- Cada página debe renderizar <main id="main-content"> (destino del skip link) -->
		<slot />
		<Footer />
	</body>
</html>
